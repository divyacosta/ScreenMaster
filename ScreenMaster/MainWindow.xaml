<Window x:Class="ScreenMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ScreenMaster.UI"
        Title="ScreenMaster" Width="1320" Height="880" MinWidth="1080" MinHeight="680"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Tabs: text only; the active one is bright with a 2px underline -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="2,0,2,0" Margin="0,0,18,0" Height="44">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: navigation left, what's on screen now in the middle (the focal line), live controls right -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel LastChildFill="True" Height="44">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image x:Name="LogoImage" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="ScreenMaster" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <RadioButton x:Name="TabLayers" Style="{StaticResource Tab}" Content="Camadas" GroupName="tabs" IsChecked="True" Checked="Tab_Changed"/>
                    <RadioButton x:Name="TabAgenda" Style="{StaticResource Tab}" Content="Agenda" GroupName="tabs" Checked="Tab_Changed"/>
                    <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE166;" Margin="4,0,0,0" Click="Undo_Click"/>
                    <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE15A;" Click="Redo_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BypassButton" Style="{StaticResource Quiet}" Content="Antes/depois" Margin="0,0,2,0"
                            PreviewMouseLeftButtonDown="Bypass_Down" PreviewMouseLeftButtonUp="Bypass_Up" MouseLeave="Bypass_Leave"/>
                    <Button x:Name="ResetButton" Style="{StaticResource Quiet}" Margin="0,0,2,0" Click="ResetButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE5D5;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource Danger}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Restaurar" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HelpToggle" Style="{StaticResource IconButton}" Content="&#xE887;" Click="HelpToggle_Click"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE8B8;" Margin="0,0,14,0" Click="SettingsButton_Click"/>
                    <ToggleButton x:Name="MasterSwitch" Style="{StaticResource Switch}" Content="Ajustes"
                                  Checked="MasterSwitch_Changed" Unchecked="MasterSwitch_Changed"/>
                </StackPanel>
                <!-- DockPanel (not StackPanel) so the sentence trims with "…" when space is short (bigger Windows text) -->
                <DockPanel x:Name="NowPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0" LastChildFill="True">
                    <TextBlock x:Name="NowTime" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    <ui:MiniAgenda x:Name="MiniAgendaStrip" DockPanel.Dock="Right" Margin="14,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NowChips" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Warnings: neutral strip, amber icon -->
        <ItemsControl Grid.Row="1" x:Name="WarningsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,7">
                        <DockPanel>
                            <TextBlock Text="&#xE002;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Warn}" Margin="0,2,10,0"/>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource Text}"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Pages: docked panes split by hairlines -->
        <Grid Grid.Row="2">
            <Grid x:Name="LayersPage">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar: presets + rules + help -->
                <Grid Grid.Column="0" Background="{StaticResource Panel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Grid.RowSpan="2"/>
                    <Grid Margin="0,12,1,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                        <DockPanel Margin="12,0,12,16">
                            <ToggleButton x:Name="LayersSwitch" Style="{StaticResource Switch}" DockPanel.Dock="Right" Content="ligadas"
                                          Checked="LayersSwitch_Changed" Unchecked="LayersSwitch_Changed"/>
                            <TextBlock Text="Camadas" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="12,0,8,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button x:Name="BtnNewPreset" Style="{StaticResource IconButton}" Content="&#xE145;" Click="NewPreset_Click"/>
                                <Button x:Name="BtnDupPreset" Style="{StaticResource IconButton}" Content="&#xE14D;" Click="DuplicatePreset_Click"/>
                                <Button x:Name="BtnRenPreset" Style="{StaticResource IconButton}" Content="&#xE3C9;" Click="RenamePreset_Click"/>
                                <Button x:Name="BtnDelPreset" Style="{StaticResource IconButton}" Content="&#xE872;" Click="DeletePreset_Click"/>
                            </StackPanel>
                            <TextBlock Text="Presets" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0"/>
                        </DockPanel>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                        <ListBox x:Name="PresetList" SelectionChanged="PresetList_SelectionChanged" PreviewMouseWheel="PresetList_PreviewMouseWheel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE5C3;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource Dim}"
                                                   Visibility="{Binding AppVisibility}" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Usado por regra de programa"/>
                                        <TextBlock DockPanel.Dock="Right" Text="agora" FontSize="11" Foreground="{StaticResource Accent}" Margin="6,0,0,0" VerticalAlignment="Top"
                                                 Visibility="{Binding OnScreenVisibility}" ToolTip="Na tela agora"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="BtnNewPresetBelow" Style="{StaticResource Quiet}" Content="+ Novo preset" HorizontalAlignment="Left" Margin="4,2,0,0" Click="NewPreset_Click"/>
                        </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="2" x:Name="RulesButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="12,8,12,0" Click="RulesButton_Click"/>
                        <CheckBox Grid.Row="3" x:Name="AutoSwitchCheck" Content="Regras ligadas" Margin="12,10,12,12" Foreground="{StaticResource Dim}"
                                  Checked="AutoSwitch_Changed" Unchecked="AutoSwitch_Changed"/>
                    </Grid>

                    <!-- Help box (Ableton-style Info View): a quiet area, not a card -->
                    <Border Grid.Row="1" x:Name="HelpBox" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0" Padding="12,10,12,12" Height="184" Background="{StaticResource Panel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" x:Name="HelpTitle" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="HelpAffects" Foreground="{StaticResource Text}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="HelpBody" Foreground="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="17"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Layer stack -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="3" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"/>
                    <DockPanel Grid.Row="0" Margin="16,12,12,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnLayerUp" Style="{StaticResource IconButton}" Content="&#xE5D8;" Click="LayerUp_Click"/>
                            <Button x:Name="BtnLayerDown" Style="{StaticResource IconButton}" Content="&#xE5DB;" Click="LayerDown_Click"/>
                            <Button x:Name="BtnLayerDup" Style="{StaticResource IconButton}" Content="&#xE14D;" Click="DuplicateLayer_Click"/>
                            <Button x:Name="BtnLayerDel" Style="{StaticResource IconButton}" Content="&#xE872;" Click="DeleteLayer_Click"/>
                            <Button x:Name="AddLayerButton" Style="{StaticResource Primary}" Content="+ Ajuste" Margin="8,0,0,0" Padding="10,3" Click="AddLayer_Click"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Camadas" Style="{StaticResource Caption}" Margin="0"/>
                            <TextBlock x:Name="EditingName" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox Grid.Row="1" x:Name="LayerList" Margin="0,0,1,0" SelectionChanged="LayerList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding CategoryBrush}" Margin="0,2"/>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource Eye}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="6,0,2,0" Tag="eye"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE000;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Danger}"
                                                       Visibility="{Binding ErrorVisibility}" ToolTip="{Binding Error}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <ItemsControl Grid.Column="3" ItemsSource="{Binding Chips}" VerticalAlignment="Center" Margin="6,0,0,0" Tag="chips">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent" MinWidth="10" Margin="5,0,0,0" ToolTip="{Binding Tip}">
                                                    <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{Binding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontFamily="{Binding Font}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="11" Margin="12,8,12,12"
                               Text="O ajuste de cima é aplicado por último. Ajustes de Cor entram antes dos de Tons (limite do Windows)."/>
                </Grid>

                <!-- Inspector -->
                <Border Grid.Column="2" x:Name="PropsHost" Background="{StaticResource Bg}" Padding="24,16,16,16">
                    <Grid>
                        <TextBlock x:Name="EmptyHint" Text="Selecione um ajuste do preset local."
                                   Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ScrollViewer x:Name="PropsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel x:Name="PropsPanel" Margin="0,0,12,0" MaxWidth="960" HorizontalAlignment="Stretch"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <ui:AgendaPage x:Name="AgendaPageControl" Visibility="Collapsed"/>
        </Grid>

        <!-- Footer: status only -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock x:Name="EngineStatus" DockPanel.Dock="Right" Foreground="{StaticResource Dim}" FontSize="11"/>
                <TextBlock Foreground="{StaticResource Dim}" FontSize="11" Text="F1 ajuda e atalhos"/>
            </DockPanel>
        </Border>

        <Popup x:Name="RulesPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=RulesButton}">
            <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6" Padding="12" Width="430" TextElement.Foreground="{StaticResource Text}">
                <StackPanel x:Name="RulesPanel"/>
            </Border>
        </Popup>
    </Grid>
</Window>
